# --- Supabase -----------------------------------------------------------------
# The project URL and its PUBLISHABLE key. Both are safe in browser code: every
# permission they have is bounded by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# The SECRET key. Server-side only — it bypasses Row Level Security, which is
# why every handler that uses it authorizes the caller explicitly first.
# Never expose this to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# --- Headless simulator (npm run simulator) -----------------------------------
# Only needed to run the simulator outside the browser. It signs in as a normal
# user and exchanges that for a short-lived, vehicle-bound simulator session; it
# never holds the secret key above.
SIMULATOR_API_URL=http://localhost:3000
SIMULATOR_EMAIL=you@example.com
SIMULATOR_PASSWORD=your-password
# Optional. Defaults to the first vehicle the account may simulate.
SIMULATOR_VEHICLE_ID=
# Set to 1 to start driving the moment the simulator connects.
SIMULATOR_JOURNEY=0
