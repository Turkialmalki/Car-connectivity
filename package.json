    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.3.3",
    "typescript": "~5.9.2"
