# React Native (Expo)
#
# Set all three to run the app against the real backend. Leave any of them unset
# and the app falls back to its in-process fixtures, so it still runs end to end
# on a machine with no credentials.
#
# Copy this file to `.env` — Expo loads EXPO_PUBLIC_ variables from there and
# inlines them at build time. Everything prefixed EXPO_PUBLIC_ ships inside the
# app bundle, so only values that are safe in a user's hands belong here.

# Where the Next.js API lives. In development this is the machine running
# `npm run dev` in web/ — a physical device needs the LAN address, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLISHABLE key. Its permissions are bounded by Row Level Security: it can
# read the vehicles the signed-in account belongs to and join their private
# channel, and it cannot write vehicle state or command results at all.
# The SECRET key belongs only in web/.env.local, never here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
